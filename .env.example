# Localhost entry and optional per-node debug APIs
MINIEUREKA_UI_PORT=18780
MINIEUREKA_NODE1_PORT=18781
MINIEUREKA_NODE2_PORT=18782
MINIEUREKA_NODE3_PORT=18783

# Replace for every non-demo deployment. Do not commit a real secret.
MINIEUREKA_GOSSIP_SECRET=replace-with-at-least-32-random-characters
MINIEUREKA_CLUSTER_ID=minieureka-local
MINIEUREKA_LOG_LEVEL=info
MINIEUREKA_RATE_LIMIT_PER_MINUTE=500000
MINIEUREKA_DEMO_MODE=true
